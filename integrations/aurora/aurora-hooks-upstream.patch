From 17e47c90e232ed187df2c66be117f6192ba947a4 Mon Sep 17 00:00:00 2001
From: Producdevity <y.gherbi.dev@gmail.com>
Date: Tue, 17 Nov 2026 14:52:49 +0100
Subject: [PATCH 1/2] Add an AURORA_RENDERER=starlet path without Dawn

With AURORA_STARLET_DIR set, AURORA_RENDERER=starlet makes Aurora create
its SDL3 window with SDL_WINDOW_OPENGL and OpenGL ES 3.1 attributes,
skip Dawn/WebGPU, gfx::initialize and the render worker, and drain the
GX FIFO on the calling thread into Starlet's bridge, which draws with
OpenGL ES and swaps the window. Without the variable Aurora behaves as
before. Without AURORA_STARLET_DIR the hooks compile to inert stubs.

Hooks for Starlet: texture data snapshots, display list sources, the
GXSetCopyFilter registers and the 342 viewport origin, each active only
under Starlet. RmlUi and ImGui are not available under Starlet.
---
 cmake/aurora_gx.cmake                        | 25 +++++++++
 lib/aurora.cpp                               | 58 ++++++++++++++------
 lib/dolphin/gx/GXDispList.cpp                |  5 ++
 lib/dolphin/gx/GXFrameBuffer.cpp             | 27 ++++++++-
 lib/dolphin/gx/GXTexture.cpp                 | 10 +++-
 lib/dolphin/gx/GXTransform.cpp               |  7 ++-
 lib/gx/fifo.cpp                              |  8 ++-
 lib/starlet_stub/starlet_backend/backend.hpp | 16 ++++++
 lib/window.cpp                               | 30 +++++++++-
 9 files changed, 164 insertions(+), 22 deletions(-)
 create mode 100644 lib/starlet_stub/starlet_backend/backend.hpp

diff --git a/cmake/aurora_gx.cmake b/cmake/aurora_gx.cmake
index a4adc13..6ea1245 100644
--- a/cmake/aurora_gx.cmake
+++ b/cmake/aurora_gx.cmake
@@ -57,6 +57,31 @@ add_library(aurora::gx ALIAS aurora_gx)
 set_target_properties(aurora_gx PROPERTIES FOLDER "aurora")
 
 target_link_libraries(aurora_gx PUBLIC aurora::core dawn::webgpu_dawn xxHash::xxhash)
+
+# Starlet back end: draws the GX stream with Starlet when AURORA_RENDERER=starlet.
+# Without AURORA_STARLET_DIR the hooks compile to nothing (lib/starlet_stub).
+set(AURORA_STARLET_DIR "" CACHE PATH "Starlet source tree")
+if (AURORA_STARLET_DIR)
+    set(AURORA_STARLET_BRIDGE_DIR "${AURORA_STARLET_DIR}/integrations/aurora")
+    if (NOT EXISTS "${AURORA_STARLET_BRIDGE_DIR}/starlet_backend/backend.cpp")
+        message(FATAL_ERROR "AURORA_STARLET_DIR is not a Starlet checkout: ${AURORA_STARLET_DIR}")
+    endif ()
+    set(STARLET_GLES ON)
+    add_subdirectory("${AURORA_STARLET_DIR}" "${CMAKE_BINARY_DIR}/starlet" EXCLUDE_FROM_ALL)
+    set(_starlet_bridge_sources)
+    foreach (_name aurora_stream backend host_memory issues texture_convert)
+        list(APPEND _starlet_bridge_sources "${AURORA_STARLET_BRIDGE_DIR}/starlet_backend/${_name}.cpp")
+    endforeach ()
+    target_sources(aurora_gx PRIVATE ${_starlet_bridge_sources})
+    # The bridge reaches Aurora's internal headers through lib/.
+    set_source_files_properties(${_starlet_bridge_sources} PROPERTIES
+            INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR}/lib")
+    target_link_libraries(aurora_gx PRIVATE starlet::gx_gles)
+else ()
+    set(AURORA_STARLET_BRIDGE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/lib/starlet_stub")
+endif ()
+target_include_directories(aurora_gx PRIVATE "${AURORA_STARLET_BRIDGE_DIR}")
+target_include_directories(aurora_core PRIVATE "${AURORA_STARLET_BRIDGE_DIR}")
 target_link_libraries(aurora_gx PRIVATE absl::btree absl::flat_hash_map sqlite3 Tracy::TracyClient PNG::PNG)
 target_compile_definitions(aurora_gx PRIVATE WEBGPU_DAWN)
 
