-void GXSetCopyFilter(GXBool aa, u8 sample_pattern[12][2], GXBool vf, u8 vfilter[7]) {}
+void GXSetCopyFilter(GXBool aa, u8 sample_pattern[12][2], GXBool vf, u8 vfilter[7]) {
+  if (!aurora::starlet_backend::enabled()) {
+    return;
+  }
+  // Starlet reads the hardware registers: BP 0x01-0x04 hold three sample locations each (x, y in
+  // 4 bits; 6 is the pixel centre), BP 0x53/0x54 seven 6-bit vertical filter coefficients.
+  for (u32 reg = 0; reg < 4; ++reg) {
+    u32 value = (0x01 + reg) << 24;
+    for (u32 i = 0; i < 3; ++i) {
+      const u32 x = aa ? sample_pattern[reg * 3 + i][0] : 6;
+      const u32 y = aa ? sample_pattern[reg * 3 + i][1] : 6;
+      value |= (x & 0xf) << (i * 8) | (y & 0xf) << (i * 8 + 4);
+    }
+    GX_WRITE_RAS_REG(value);
+  }
+  // Without the filter the hardware coefficients are 0, 0, 21, 22, 21, 0, 0, which leave rows unchanged.
+  static constexpr u8 passthrough[7] = {0, 0, 21, 22, 21, 0, 0};
+  const u8* coefficients = vf ? vfilter : passthrough;
+  u32 coeff0 = 0x53u << 24, coeff1 = 0x54u << 24;
+  for (u32 i = 0; i < 4; ++i) coeff0 |= (coefficients[i] & 0x3fu) << (i * 6);
+  for (u32 i = 0; i < 3; ++i) coeff1 |= (coefficients[4 + i] & 0x3fu) << (i * 6);
+  GX_WRITE_RAS_REG(coeff0);
+  GX_WRITE_RAS_REG(coeff1);
+  __gx->bpSent = 1;
+}
 
 void GXSetDispCopyGamma(GXGamma gamma) {}
 
