@@ -0,0 +1,16 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Stand-in for the Starlet bridge when AURORA_STARLET_DIR is not set: every hook is inert.
+namespace aurora::starlet_backend {
+constexpr bool enabled() noexcept { return false; }
+inline void process(const std::uint8_t*, std::size_t) {}
+inline void end_frame() {}
+inline void set_gl_attributes() {}
+inline bool initialize() { return false; }
+inline void shutdown() {}
+inline const void* texture_data(const void* data, std::size_t) { return data; }
+inline void note_display_list(const void*, std::size_t) {}
+} // namespace aurora::starlet_backend
